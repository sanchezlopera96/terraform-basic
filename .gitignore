# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Private keys
*.pem
*.ppk

# Variables locales con datos sensibles (admin_cidr, key_name, etc.)
*.auto.tfvars
