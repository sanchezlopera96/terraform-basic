# Plantilla del Secret de la API. NO poner valores reales aquí.
#   1. Copiar a k8s/api-secret.yaml (está en .gitignore). Esta plantilla usa la
#      extensión .example para que "kubectl apply -f k8s/" no la aplique.
#   2. Reemplazar los valores <...>
#   3. kubectl apply -f k8s/api-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: eventosvivos-api
  namespace: eventosvivos
type: Opaque
stringData:
  # Host = output db_address de Terraform. RDS exige SSL (SSL Mode=Require).
  ConnectionStrings__Default: "Host=<db_address>;Port=5432;Database=eventosvivos;Username=admin_user;Password=<db_password>;SSL Mode=Require"
  # Mínimo 32 caracteres (la API no arranca con una clave más corta).
  Jwt__SigningKey: "<clave-aleatoria-de-32-o-mas-caracteres>"
  AdminCredentials__Username: "admin"
  # Hash BCrypt de la contraseña de admin. Comillas simples por los "$" del hash.
  AdminCredentials__PasswordHash: '<hash-bcrypt>'
